{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "notes",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "verified": {
                  "type": "boolean"
                }
              },
              "required": [
                "text",
                "quote"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "heading",
          "bullets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "title",
    "sections"
  ],
  "additionalProperties": false
}
